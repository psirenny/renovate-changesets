{
  "name": "renovate-changesets",
  "version": "1.0.0",
  "description": "Changesets for all of your Renovate updates.",
  "keywords": [
    "catalog",
    "changeset",
    "changesets",
    "monorepo",
    "renovate",
    "workspace"
  ],
  "homepage": "https://github.com/psirenny/renovate-changesets#readme",
  "bugs": {
    "url": "https://github.com/psirenny/renovate-changesets/issues"
  },
  "license": "MIT",
  "author": "Dennis Torres <djtorres@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/psirenny/renovate-changesets.git"
  },
  "bin": {
    "renovate-changesets": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "actionlint:check": "github-actionlint",
    "build": "tsdown",
    "check-all": "turbo run check",
    "fix": "pnpm run oxfmt:fix && pnpm run oxlint:fix && pnpm run markdownlint:fix",
    "markdownlint:check": "markdownlint-cli2",
    "markdownlint:fix": "markdownlint-cli2 --fix",
    "npmpkgjsonlint:check": "npmPkgJsonLint .",
    "oxfmt:check": "oxfmt --check .",
    "oxfmt:fix": "oxfmt .",
    "oxlint:check": "oxlint --type-aware --max-warnings 0",
    "oxlint:fix": "oxlint --fix --type-aware --max-warnings 0",
    "prepack": "pnpm run build",
    "publish-packages": "changeset publish",
    "renovateconfig:check": "renovate-config-validator --strict",
    "test": "vitest run",
    "typescript:check": "tsc --noEmit",
    "v8r:check": "v8r \"**/*.json\" \"**/*.yaml\"",
    "version": "changeset version"
  },
  "dependencies": {
    "@changesets/config": "^4.0.0",
    "@changesets/format": "^0.1.2",
    "@changesets/should-skip-package": "^1.0.0",
    "@logtape/logtape": "^2.3.2",
    "@manypkg/get-packages": "^3.1.0",
    "handlebars": "^4.7.9",
    "smol-toml": "^1.8.0",
    "yargs": "^18.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@fast-check/vitest": "0.5.0",
    "@logtape/lint": "2.3.4",
    "@logtape/testing": "2.3.4",
    "@types/node": "26.5.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "5.0.0",
    "github-actionlint": "1.7.12",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.2",
    "npm-package-json-lint": "11.0.0",
    "npm-package-json-lint-config-default": "10.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "renovate": "44.82.5",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "v8r": "6.1.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@changesets/cli": "^3"
  },
  "engines": {
    "node": "^24 || >=26"
  },
  "packageManager": "pnpm@12.4.1"
}
